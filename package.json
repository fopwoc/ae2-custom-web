{
  "name": "ae2-terminal-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "check": "pnpm --recursive check",
    "dev": "pnpm --filter @ae2-terminal/app dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive test",
    "test:e2e": "pnpm --filter @ae2-terminal/app test:e2e",
    "version:resolve": "node scripts/resolve-version.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1"
  }
}
