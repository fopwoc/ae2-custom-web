    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@unocss/extractor-svelte": "^66.11.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
