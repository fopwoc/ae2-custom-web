    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "@unocss/extractor-svelte": "^66.8.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
